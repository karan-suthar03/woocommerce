# ============================================================
# Swami Om Enterprises – Next.js storefront
# Copy to .env.local (development) or .env.production (production). No secrets here.
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.
# ============================================================

# Backend URL as seen from the browser and from the Next.js server.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Optional server-side override of the backend URL (e.g. an internal address).
MEDUSA_BACKEND_URL=
MEDUSA_ADMIN_BACKEND_URL=http://localhost:9000
# Admin → Settings → Publishable API Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxx
# Public URL of this storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=in
NEXT_PUBLIC_DEMO_MODE=false

NEXT_PUBLIC_SHOP_NAME=Swami Om Enterprises
NEXT_PUBLIC_SHOP_DESCRIPTION=Swami Om Enterprises Online Store

# Razorpay public key – must be the same mode (test/live) as the backend's RAZORPAY_MODE.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Must equal the backend's REVALIDATE_SECRET, or product edits will not refresh the shop.
REVALIDATE_SECRET=

# Optional CDN / object storage for images.
NEXT_PUBLIC_CDN_SPACE_DOMAIN=
NEXT_PUBLIC_SPACE_DOMAIN=
NEXT_PUBLIC_SPACE_ENDPOINT=
