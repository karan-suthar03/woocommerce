# ============================================================
# Swami Om Enterprises – Medusa backend
# Copy to .env (production) or .env.local (development). No real secrets here.
# The build (npm run build) copies .env into .medusa/server/.env – edit the
# source .env, not the copy, or the next build will overwrite your change.
# ============================================================

# development | production. Production refuses weak JWT/COOKIE secrets.
NODE_ENV=development
# Public URL of this backend (used for uploaded file URLs: <BACKEND_URL>/static/...).
BACKEND_URL=http://localhost:9000
# Public URL of the storefront (used in password-reset links and to refresh product pages).
STOREFRONT_URL=http://localhost:8000

# --- Secrets (production: 32+ random characters each, e.g. `openssl rand -hex 32`)
JWT_SECRET=
COOKIE_SECRET=
# Shared with the storefront's REVALIDATE_SECRET so product edits refresh the shop.
REVALIDATE_SECRET=

# --- Database / cache
# Use a LOCAL database for development – never point local dev at the live DB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/swami_om_dev
# Optional in development; required in production (event bus, workflows, locking).
REDIS_URL=

# --- CORS (comma-separated origins)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# --- Razorpay
# test | live (default test). Picks which key set below is used; startup fails
# if the key does not match the mode. The storefront key must be the same mode.
RAZORPAY_MODE=test

# Test mode (Razorpay dashboard → Test Mode → API Keys / Webhooks)
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
# Only for Razorpay partner accounts acting for a sub-merchant; leave empty otherwise.
RAZORPAY_TEST_ACCOUNT=
RAZORPAY_TEST_AUTO_EXPIRY_PERIOD=30
RAZORPAY_TEST_MANUAL_EXPIRY_PERIOD=7200

# Live mode (Razorpay dashboard → Live Mode)
RAZORPAY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT=
RAZORPAY_AUTO_EXPIRY_PERIOD=30
RAZORPAY_MANUAL_EXPIRY_PERIOD=7200

# Minutes before a paid Razorpay payment with no order is auto-refunded (default 15).
ORPHAN_REFUND_MIN_AGE_MINUTES=15

# --- Email (order confirmations, OTP, password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Swami Om Enterprises
# Where new-order alerts go (defaults to SMTP_FROM_EMAIL).
ADMIN_EMAIL=

# --- Admin
# Set to true only to allow the admin "reset store data" action in production.
ALLOW_STORE_RESET=false
